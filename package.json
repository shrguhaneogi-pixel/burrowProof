{
  "name": "burrowproof",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite --port 3000 --strictPort",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0 && prettier --check --ignore-path .gitignore \"**/*.{ts,tsx,js,css,html}\"",
